# お問い合わせフォームのメール送信（Resend）
# 実際の値は .env.local（ローカル）と Vercel の Environment Variables に設定する。
# ※ このファイルはテンプレート。実際のキーはコミットしないこと。

# Resend の API キー（https://resend.com のダッシュボードで発行）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 問い合わせの受信先メールアドレス（社内で受け取るアドレス。非公開）
CONTACT_TO=info@example.com

# 送信元（From）。Resend で DNS 認証済みのドメインを使う。
# 表示名つきの形式が使える： "株式会社〇 <noreply@example.com>"
CONTACT_FROM=株式会社〇 <noreply@example.com>

# --- スパム対策：Cloudflare Turnstile（https://dash.cloudflare.com → Turnstile）---
# サイトキー（公開。クライアントで使うため NEXT_PUBLIC_ 接頭辞が必要）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_xxxxxxxxxxxx
# シークレットキー（非公開。サーバー側の検証で使う）
TURNSTILE_SECRET_KEY=0x4AAAAAAA_yyyyyyyyyyyy
# ※ 両方が未設定なら Turnstile 検証はスキップ（開発時はキー無しでも動作）。
#   本番では Cloudflare で発行した実キーを両方設定すること。
